    "GitHub has not finished creating the repository. DevHub tries again at the next sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub hat das Repository noch nicht fertig angelegt. DevHub versucht es bei der nächsten Synchronisierung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub aún no terminó de crear el repositorio. DevHub lo intentará de nuevo en la próxima sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub n’a pas fini de créer le dépôt. DevHub réessaiera à la prochaine synchronisation."

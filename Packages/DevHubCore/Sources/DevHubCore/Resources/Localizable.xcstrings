{
  "sourceLanguage": "en",
  "strings": {
    "%@ exited with code %d%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde mit Code %d beendet%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ exited with code %2$d%3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminó con el código %d%@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ s’est terminé avec le code %d%@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がコード%dで終了しました%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@이(가) 코드 %d(으)로 종료되었습니다%@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminou com o código %d%@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ завершилась с кодом %d%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已退出，退出代码 %d%@"
          }
        }
      }
    },

    "No Node version manager found. DevHub looked for nvm, fnm, Volta and asdf.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Node-Versionsverwaltung gefunden. DevHub hat nach nvm, fnm, Volta und asdf gesucht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún gestor de versiones de Node. DevHub buscó nvm, fnm, Volta y asdf."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun gestionnaire de versions de Node trouvé. DevHub a cherché nvm, fnm, Volta et asdf."
          }
        },
        "ja": {

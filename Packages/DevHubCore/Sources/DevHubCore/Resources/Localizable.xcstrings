        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les versions de Node sont désactivées dans les Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ですべてのNodeバージョンがオフになっています。"
          }
        },

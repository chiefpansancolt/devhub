      }
    },
    "%@ printed output that DevHub could not read.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat eine Ausgabe geliefert, die DevHub nicht lesen konnte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ devolvió una salida que DevHub no pudo leer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a produit une sortie que DevHub n’a pas pu lire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の出力をDevHubは読み取れませんでした。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@의 출력을 DevHub가 읽을 수 없었습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O %@ gerou uma saída que o DevHub não conseguiu ler."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вывод %@ не удалось прочитать в DevHub."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHub 无法读取 %@ 的输出。"
          }
        }
      }
    },

    "%@ exited with code %d%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde mit Code %d beendet%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ exited with code %2$d%3$@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ terminó con el código %d%@"
          }
        },
        "fr": {
          "stringUnit": {

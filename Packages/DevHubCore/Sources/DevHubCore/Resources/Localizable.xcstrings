    "Could not read the output of %@: %@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ausgabe von %@ konnte nicht gelesen werden: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Could not read the output of %1$@: %2$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の出力を読み取れませんでした: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取 %@ 的输出：%@"
          }
        }
      }
    },
    "DevHub has no way to uninstall this package.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHub kann dieses Paket nicht deinstallieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHubはこのパッケージをアンインストールできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHub 无法卸载此软件包。"
          }
        }
      }
    },
    "DevHub has no way to update this package.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHub kann dieses Paket nicht aktualisieren."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHubはこのパッケージをアップデートできません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHub 无法更新此软件包。"
          }
        }
      }
    },
    "Every Node version is turned off in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Node-Versionen sind in den Einstellungen ausgeschaltet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ですべてのNodeバージョンがオフになっています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置中已关闭所有 Node 版本。"
          }
        }
      }
    },
    "Every Ruby version is turned off in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Ruby-Versionen sind in den Einstellungen ausgeschaltet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ですべてのRubyバージョンがオフになっています。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设置中已关闭所有 Ruby 版本。"
          }
        }
      }
    },
    "Homebrew was not found in /opt/homebrew or /usr/local.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Homebrew wurde weder in /opt/homebrew noch in /usr/local gefunden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "/opt/homebrewにも/usr/localにもHomebrewが見つかりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 /opt/homebrew 或 /usr/local 中未找到 Homebrew。"
          }
        }
      }
    },
    "No %@ versions were found in this folder.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesem Ordner wurden keine %@-Versionen gefunden."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このフォルダには%@のバージョンが見つかりません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此文件夹中未找到 %@ 版本。"
          }
        }
      }
    },
    "No Node version manager found. DevHub looked for nvm, fnm, Volta and asdf.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Node-Versionsverwaltung gefunden. DevHub hat nach nvm, fnm, Volta und asdf gesucht."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Nodeのバージョン管理ツールが見つかりません。DevHubはnvm、fnm、Volta、asdfを探しました。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未找到 Node 版本管理器。DevHub 查找了 nvm、fnm、Volta 和 asdf。"
          }
        }
      }
    },
    "No Node versions were found in %@.": {
      "localizations": {

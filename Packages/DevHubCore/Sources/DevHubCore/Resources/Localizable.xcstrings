    "DevHub has no way to uninstall this package.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHub kann dieses Paket nicht deinstallieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHub no puede desinstalar este paquete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHub ne peut pas désinstaller ce paquet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHubはこのパッケージをアンインストールできません。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O DevHub não consegue desinstalar este pacote."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "DevHub 无法卸载此软件包。"
          }
        }
      }
    },

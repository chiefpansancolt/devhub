{
  "sourceLanguage": "en",
  "strings": {
    "%@ exited with code %d%@": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde mit Code %d beendet%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ exited with code %2$d%3$@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がコード%dで終了しました%@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已退出，退出代码 %d%@"
          }
        }
      }
    },
    "%@ was cancelled": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde abgebrochen"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はキャンセルされました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已取消"
          }
        }
      }
    },

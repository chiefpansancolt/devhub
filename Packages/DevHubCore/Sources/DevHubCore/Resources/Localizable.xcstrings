    "The file kept changing on GitHub. DevHub tries again at the next sync.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei hat sich auf GitHub immer wieder geändert. DevHub versucht es bei der nächsten Synchronisierung erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo seguía cambiando en GitHub. DevHub lo intentará de nuevo en la próxima sincronización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n’a pas cessé de changer sur GitHub. DevHub réessaiera à la prochaine synchronisation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub上のファイルが変更され続けました。次回の同期でDevHubが再試行します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub의 파일이 계속 변경되었습니다. 다음 동기화 때 DevHub가 다시 시도합니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo continuou mudando no GitHub. O DevHub tenta novamente na próxima sincronização."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл на GitHub постоянно менялся. DevHub повторит попытку при следующей синхронизации."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 上的文件一直在变化。DevHub 将在下次同步时重试。"
          }
        }
      }
    },
    "The file on GitHub was written by a newer version of DevHub. Update DevHub to sync again. Nothing was uploaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei auf GitHub wurde von einer neueren DevHub-Version geschrieben. Aktualisiere DevHub, um wieder zu synchronisieren. Es wurde nichts hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo de GitHub lo escribió una versión más reciente de DevHub. Actualiza DevHub para volver a sincronizar. No se subió nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier sur GitHub a été écrit par une version plus récente de DevHub. Mettez DevHub à jour pour synchroniser de nouveau. Rien n’a été envoyé."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub上のファイルは新しいバージョンのDevHubで作成されました。再び同期するにはDevHubをアップデートしてください。何もアップロードされていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub의 파일은 더 새로운 DevHub 버전에서 작성되었습니다. 다시 동기화하려면 DevHub를 업데이트하세요. 아무것도 업로드되지 않았습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O arquivo no GitHub foi criado por uma versão mais recente do DevHub. Atualize o DevHub para sincronizar novamente. Nada foi enviado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл на GitHub создан более новой версией DevHub. Обновите DevHub, чтобы снова синхронизировать. Ничего не было загружено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GitHub 上的文件由较新版本的 DevHub 写入。请更新 DevHub 后再同步。没有上传任何内容。"
          }
        }
      }
    },

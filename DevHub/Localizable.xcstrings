    "Turn off a tool you do not use. DevHub stops checking it and hides it from the menu bar, the window sidebar and these Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte ein Werkzeug aus, das du nicht benutzt. DevHub prüft es dann nicht mehr und blendet es in der Menüleiste, in der Seitenleiste des Fensters und in diesen Einstellungen aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva una herramienta que no uses. DevHub deja de comprobarla y la oculta en la barra de menús, la barra lateral de la ventana y estos Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez un outil que vous n’utilisez pas. DevHub cesse de le vérifier et le masque dans la barre des menus, la barre latérale de la fenêtre et ces Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使わないツールはオフにしてください。DevHubはそのツールのチェックを止め、メニューバー、ウインドウのサイドバー、この設定画面から非表示にします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용하지 않는 도구는 끄세요. DevHub가 해당 도구를 확인하지 않으며 메뉴 막대, 윈도우 사이드바, 이 설정에서 숨깁니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative uma ferramenta que você não usa. O DevHub para de verificá-la e a oculta na barra de menus, na barra lateral da janela e nestes Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите инструмент, которым не пользуетесь. DevHub перестанет его проверять и скроет его в строке меню, боковой панели окна и этих настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭你不使用的工具。DevHub 将不再检查它，并在菜单栏、窗口边栏和此设置中隐藏它。"
          }
        }
      }
    },
    "Turn on Homebrew, Node or Ruby in Settings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte Homebrew, Node oder Ruby in den Einstellungen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Homebrew, Node o Ruby en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Homebrew, Node ou Ruby dans les Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定でHomebrew、Node、Rubyのいずれかをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정에서 Homebrew, Node 또는 Ruby를 켜세요."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative o Homebrew, o Node ou o Ruby em Ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включите Homebrew, Node или Ruby в настройках."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“设置”中开启 Homebrew、Node 或 Ruby。"
          }
        }
      }
    },

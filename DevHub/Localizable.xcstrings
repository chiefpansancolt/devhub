    "Each package is updated one at a time. This can take a while.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Pakete werden nacheinander aktualisiert. Das kann eine Weile dauern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los paquetes se actualizan uno a uno. Puede tardar un rato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les paquets sont mis à jour un par un. Cela peut prendre un moment."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージは1つずつアップデートされます。時間がかかる場合があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지는 하나씩 업데이트됩니다. 시간이 걸릴 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os pacotes são atualizados um de cada vez. Isso pode levar um tempo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакеты обновляются по одному. Это может занять некоторое время."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "软件包将逐个更新，这可能需要一些时间。"
          }
        }
      }
    },

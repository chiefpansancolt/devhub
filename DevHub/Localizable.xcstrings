          "stringUnit": {
            "state": "translated",
            "value": "Tous les outils sont désactivés. Activez-les dans les Réglages."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべてのツールがオフです。設定でオンにしてください。"

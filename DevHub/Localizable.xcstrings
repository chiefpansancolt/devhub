            "state": "translated",
            "value": "Alle Werkzeuge sind ausgeschaltet. Schalte sie in den Einstellungen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las herramientas están desactivadas. Actívalas en Ajustes."
          }
        },

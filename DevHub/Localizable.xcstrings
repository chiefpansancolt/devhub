    "It is removed from rustup. You can install it again later.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wird aus rustup entfernt. Du kannst sie später wieder installieren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina de rustup. Puedes instalarla de nuevo más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Elle est supprimée de rustup. Vous pourrez la réinstaller plus tard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "rustupから削除されます。後でもう一度インストールできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "rustup에서 제거됩니다. 나중에 다시 설치할 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ela é removida do rustup. Você pode instalá-la novamente depois."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он будет удалён из rustup. Позже его можно установить снова."

    "Command output appears here when you update or uninstall a package.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier erscheint die Befehlsausgabe, wenn du ein Paket aktualisierst oder deinstallierst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida de comandos aparece aquí cuando actualizas o desinstalas un paquete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie des commandes apparaît ici lorsque vous mettez à jour ou désinstallez un paquet."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージをアップデートまたはアンインストールすると、コマンドの出力がここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지를 업데이트하거나 제거하면 명령 출력이 여기에 표시됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A saída dos comandos aparece aqui quando você atualiza ou desinstala um pacote."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь появится вывод команд при обновлении или удалении пакета."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更新或卸载软件包时，命令输出会显示在这里。"
          }
        }
      }
    },
    "Command output makes the file larger but helps when something fails.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Befehlsausgabe vergrößert die Datei, hilft aber, wenn etwas fehlschlägt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La salida de comandos hace el archivo más grande, pero ayuda cuando algo falla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La sortie des commandes alourdit le fichier, mais aide en cas de problème."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "コマンドの出力を含めるとファイルは大きくなりますが、問題が起きたときに役立ちます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "명령 출력을 포함하면 파일이 커지지만 문제가 생겼을 때 도움이 됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A saída dos comandos deixa o arquivo maior, mas ajuda quando algo falha."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вывод команд увеличивает файл, но помогает при сбоях."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "命令输出会使文件变大，但出错时很有帮助。"
          }
        }
      }
    },

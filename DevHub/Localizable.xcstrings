    "No Node version manager found. Choose the folder that holds your Node versions.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Node-Versionsverwaltung gefunden. Wähle den Ordner mit deinen Node-Versionen aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontró ningún gestor de versiones de Node. Elige la carpeta que contiene tus versiones de Node."

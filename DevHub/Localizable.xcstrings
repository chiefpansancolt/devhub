    "This deletes every entry from the history file. Your packages are not changed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dadurch werden alle Einträge der Verlaufsdatei gelöscht. Deine Pakete bleiben unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra todas las entradas del archivo de historial. Tus paquetes no se modifican."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime toutes les entrées du fichier d’historique. Vos paquets ne sont pas modifiés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これにより履歴ファイルのすべてのエントリが削除されます。パッケージは変更されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록 파일의 모든 항목이 삭제됩니다. 패키지는 변경되지 않습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Isso apaga todas as entradas do arquivo de histórico. Seus pacotes não são alterados."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все записи в файле истории будут удалены. Ваши пакеты не изменятся."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这将删除历史记录文件中的所有条目。你的软件包不会受到影响。"

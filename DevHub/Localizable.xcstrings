    "Updates run one package at a time in each bucket.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Updates laufen pro Paketmanager einzeln nacheinander."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las actualizaciones se ejecutan de una en una en cada gestor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mises à jour s’exécutent une par une dans chaque gestionnaire."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アップデートは各パッケージマネージャー内で1つずつ実行されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "업데이트는 각 패키지 관리자에서 한 번에 하나씩 실행됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As atualizações são executadas uma por vez em cada gerenciador."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обновления выполняются по одному пакету в каждом менеджере."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个包管理器内的更新逐个运行。"
          }
        }
      }
    },

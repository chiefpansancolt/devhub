    "One line per action, in JSON Lines format. Each line has a timestamp.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Zeile pro Aktion im JSON-Lines-Format. Jede Zeile hat einen Zeitstempel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una línea por acción, en formato JSON Lines. Cada línea lleva una marca de tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une ligne par action, au format JSON Lines. Chaque ligne porte un horodatage."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作ごとに1行、JSON Lines形式です。各行にタイムスタンプが付きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "동작마다 한 줄씩, JSON Lines 형식입니다. 각 줄에 타임스탬프가 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma linha por ação, no formato JSON Lines. Cada linha tem um carimbo de data e hora."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна строка на действие, формат JSON Lines. В каждой строке есть метка времени."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个操作一行，采用 JSON Lines 格式。每行都有时间戳。"
          }
        }
      }
    },

    "Nothing else installed depends on it. Its files are removed from disk.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts anderes Installiertes hängt davon ab. Die Dateien werden vom Datenträger entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada más instalado depende de él. Sus archivos se eliminan del disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’autre d’installé n’en dépend. Ses fichiers sont supprimés du disque."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のインストール済みパッケージはこれに依存していません。ファイルはディスクから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 다른 항목은 이것에 의존하지 않습니다. 파일이 디스크에서 삭제됩니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada mais instalado depende dele. Os arquivos são removidos do disco."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От него не зависит ничто другое. Его файлы будут удалены с диска."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有其他已安装的软件包依赖它。其文件将从磁盘中删除。"
          }
        }
      }
    },

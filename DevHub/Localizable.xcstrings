    "Other installed packages need this: %@. They may stop working.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere installierte Pakete benötigen dies: %@. Sie funktionieren möglicherweise nicht mehr."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otros paquetes instalados lo necesitan: %@. Podrían dejar de funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’autres paquets installés en ont besoin : %@. Ils pourraient cesser de fonctionner."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "他のインストール済みパッケージがこれを必要としています: %@。動作しなくなる可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설치된 다른 패키지가 이것을 필요로 합니다: %@. 작동하지 않을 수 있습니다."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Outros pacotes instalados precisam dele: %@. Eles podem parar de funcionar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он нужен другим установленным пакетам: %@. Они могут перестать работать."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其他已安装的软件包需要它：%@。它们可能无法继续使用。"
          }
        }
      }
    },

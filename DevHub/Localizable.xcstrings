    "Cargo asks crates.io for the newest version of each tool.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo fragt bei crates.io die neueste Version jedes Tools ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo consulta a crates.io la versión más reciente de cada herramienta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargo demande à crates.io la version la plus récente de chaque outil."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cargoがcrates.ioに各ツールの最新バージョンを問い合わせます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",

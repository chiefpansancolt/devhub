    "Bucket numbers show available updates. Sub-rows show updates of installed.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlen bei den Paketmanagern zeigen verfügbare Updates. Die Zeilen darunter zeigen Updates von installierten Paketen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los números junto a los gestores indican las actualizaciones disponibles. Las filas de debajo muestran las de los paquetes instalados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les nombres à côté des gestionnaires indiquent les mises à jour disponibles. Les lignes en dessous montrent celles des paquets installés."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージマネージャーの数字は利用可能なアップデート数です。下の行はインストール済みパッケージのアップデートを表します。"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os números ao lado dos gerenciadores mostram as atualizações disponíveis. As linhas abaixo mostram as dos pacotes instalados."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包管理器旁的数字表示可用更新数量，下方各行表示已安装软件包的更新。"
          }
        }
      }
    },
